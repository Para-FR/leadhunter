# ─── MongoDB ───────────────────────────────────────────────
# URI de connexion (mongodb://user:pass@host:port ou mongodb+srv://...)
MONGODB_URI=mongodb://user:password@localhost:27017
MONGODB_DB=browseractpoc

# ─── BrowserAct ────────────────────────────────────────────
# Clé API : https://www.browseract.com (le token = la partie "app-...")
BROWSERACT_API_KEY=app-xxxxxxxxxxxxxxxxxxxx
BROWSERACT_API_BASE=https://api.browseract.com

# ─── Optionnel ─────────────────────────────────────────────
# ID d'un navigateur stealth BrowserAct précis à utiliser pour le scraping
# BROWSER_ID=
